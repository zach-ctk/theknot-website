---
import { resolveImage, renderMarkdocToHtml } from './_utils';

interface Props {
  image?: string;
  imageLibraryPath?: string;
  alt?: string;
  imageSide?: 'left' | 'right';
  content?: unknown;
  backgroundColor?: string;
  textColor?: string;
}

const {
  alt = '',
  imageSide = 'left',
  content,
  backgroundColor = 'transparent',
  textColor = '#000000',
  ...imageRefs
} = Astro.props;

const imageSrc = resolveImage(imageRefs);
const html = renderMarkdocToHtml(content);
const sectionStyle = [
  backgroundColor && backgroundColor !== 'transparent'
    ? `background-color: ${backgroundColor};`
    : '',
  `color: ${textColor};`,
]
  .filter(Boolean)
  .join(' ');
---

<section
  class={`block-two-column block-two-column--image-${imageSide}`}
  style={sectionStyle}
>
  <div class="block-two-column__inner">
    {imageSrc && (
      <div class="block-two-column__image-wrap">
        <img src={imageSrc} alt={alt} class="block-two-column__image" loading="lazy" decoding="async" />
      </div>
    )}
    <div class="block-two-column__text" set:html={html}></div>
  </div>
</section>

<style>
  .block-two-column {
    width: 100%;
    padding: 64px 24px;
  }

  .block-two-column__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .block-two-column--image-right .block-two-column__image-wrap {
    order: 2;
  }

  .block-two-column__image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .block-two-column__text {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.6;
  }

  .block-two-column__text :global(h1),
  .block-two-column__text :global(h2),
  .block-two-column__text :global(h3) {
    font-family: var(--font-heading, 'Zing Rust', sans-serif);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 16px 0;
  }

  .block-two-column__text :global(h1) {
    font-size: 36px;
  }
  .block-two-column__text :global(h2) {
    font-size: 28px;
  }
  .block-two-column__text :global(h3) {
    font-size: 22px;
  }

  .block-two-column__text :global(p) {
    margin: 0 0 16px 0;
  }

  .block-two-column__text :global(a) {
    color: inherit;
    text-decoration: underline;
  }

  .block-two-column__text :global(ul),
  .block-two-column__text :global(ol) {
    margin: 0 0 16px 24px;
    padding: 0;
  }

  @media (max-width: 768px) {
    .block-two-column {
      padding: 48px 16px;
    }

    .block-two-column__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .block-two-column--image-right .block-two-column__image-wrap {
      order: 0;
    }

    .block-two-column__text {
      font-size: 16px;
    }
  }
</style>
