---
import { resolveImage } from './_utils';

interface Props {
  image?: string;
  imageLibraryPath?: string;
  alt?: string;
  caption?: string;
  width?: 'contained' | 'full';
  backgroundColor?: string;
}

const {
  alt = '',
  caption,
  width = 'contained',
  backgroundColor = 'transparent',
  ...imageRefs
} = Astro.props;

const imageSrc = resolveImage(imageRefs);
const sectionStyle =
  backgroundColor && backgroundColor !== 'transparent'
    ? `background-color: ${backgroundColor};`
    : '';
---

{imageSrc && (
  <section
    class={`block-image block-image--${width}`}
    style={sectionStyle}
  >
    <figure class="block-image__figure">
      <img
        src={imageSrc}
        alt={alt}
        class="block-image__img"
        loading="lazy"
        decoding="async"
      />
      {caption && <figcaption class="block-image__caption">{caption}</figcaption>}
    </figure>
  </section>
)}

<style>
  .block-image {
    width: 100%;
    padding: 48px var(--page-padding-x);
  }

  .block-image--full {
    padding: 0;
  }

  .block-image__figure {
    margin: 0 auto;
    max-width: 1000px;
  }

  .block-image--full .block-image__figure {
    max-width: 100%;
  }

  .block-image__img {
    display: block;
    width: 100%;
    height: auto;
  }

  .block-image__caption {
    margin-top: 12px;
    text-align: center;
    font-family: var(--font-body);
    font-size: 14px;
    color: #555;
    font-style: italic;
  }

  .block-image--full .block-image__caption {
    padding: 12px 24px 24px;
  }

  @media (max-width: 768px) {
    .block-image {
      padding: 32px var(--page-padding-x);
    }

    .block-image--full {
      padding: 0;
    }
  }
</style>
