---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import fs from "node:fs";
import path from "node:path";
import ProratedMembershipPrice from "@/components/ProratedMembershipPrice.astro";
import { colors } from "@content/brand.json";

interface LocalPartner {
  name: string;
  handle?: string;
  description?: string;
  address?: string;
  hours?: string;
  image?: string;
}

const benefitsFallback = [
  { title: "FREE GEAR RENTALS", description: "For you & your guests!" },
  {
    title: "ONE FREE MONTHLY GUEST PASS",
    description:
      "Additional guest passes available for $15 each. Bring up to 3 guests at one time",
  },
  { title: "FREE BELAY CLASS + CERTIFICATION", description: "" },
  {
    title: "FREE YOGA + FITNESS CLASSES",
    description: "At least one class offered every single day",
  },
  { title: "UNLIMITED CLIMBING DURING BUSINESS HOURS", description: "" },
  { title: "20% OFF ALL PRODUCTS IN OUR GEAR SHOP", description: "" },
  {
    title: "MEMBER KEY TAG FOR SPECIAL DISCOUNTS AT LOCAL BUSINESSES",
    description: "Check out all of the spots below!",
  },
];

const membershipPathCandidates = [
  path.join(process.cwd(), "src/content/pages/membership.json"),
  path.join(process.cwd(), "src/content/pages/membership/index.json"),
];
const membershipPath =
  membershipPathCandidates.find((candidatePath) =>
    fs.existsSync(candidatePath),
  ) || membershipPathCandidates[0];

let membershipPage: {
  hero?: {
    headline?: string;
    subtext?: string;
    backgroundImage?: string;
    backgroundImageLibraryPath?: string;
    backgroundVideo?: string;
    backgroundVideoLibraryPath?: string;
    objectPositionX?: number;
    objectPositionY?: number;
  };
  manageSection?: { headline?: string };
  portalButton?: { text?: string; url?: string };
  pricing?: {
    sectionHeading?: string;
    headline?: string;
    billingText?: string;
    image?: string;
    imageLibraryPath?: string;
  };
  benefits?: { title?: string; description?: string }[];
  benefitsImage?: string;
  benefitsImageLibraryPath?: string;
  localDiscounts?: {
    headline?: string;
    intro?: string;
    partners15?: LocalPartner[];
    partners10?: LocalPartner[];
  };
  bottomCta?: {
    headline?: string;
    description?: string;
    buttonText?: string;
    buttonUrl?: string;
  };
};

try {
  membershipPage = JSON.parse(fs.readFileSync(membershipPath, "utf-8"));
} catch {
  membershipPage = {
    hero: {
      headline: "MEMBERSHIP",
      backgroundVideo: "/images/canva-final/membership-hero.mp4",
      backgroundImage: "/images/canva-final/canva-hills-background.jpg",
    },
    manageSection: { headline: "MANAGE YOUR MEMBERSHIP" },
    portalButton: {
      text: "REDPOINT MEMBER PORTAL",
      url: "https://portal.climbtheknot.com",
    },
    pricing: {
      sectionHeading: "BILLING",
      headline: "START YOUR MEMBERSHIP TODAY FOR ONLY $XX",
      image: "/images/canva-final/membership-wall-gear-1280.jpg",
    },
    benefits: benefitsFallback,
    benefitsImage: "/images/canva-final/membership-climber-benefits-960.jpg",
  };
}

const toPublicUrl = (libraryPath?: string) =>
  libraryPath && libraryPath.startsWith("public/")
    ? `/${libraryPath.slice("public/".length)}`
    : undefined;

const heroContent = membershipPage.hero || {};
const manageSection = membershipPage.manageSection || {};
const portalButton = membershipPage.portalButton || {};
const pricing = membershipPage.pricing || {};
const benefits =
  Array.isArray(membershipPage.benefits) && membershipPage.benefits.length > 0
    ? membershipPage.benefits
    : benefitsFallback;
const membershipHeroImage =
  heroContent.backgroundImage ||
  toPublicUrl(heroContent.backgroundImageLibraryPath) ||
  "/images/canva-final/canva-hills-background.jpg";
const membershipHeroVideo =
  heroContent.backgroundVideo ||
  toPublicUrl(heroContent.backgroundVideoLibraryPath) ||
  "/images/canva-final/membership-hero.mp4";
const manageImage =
  pricing.image ||
  toPublicUrl(pricing.imageLibraryPath) ||
  "/images/canva-final/membership-wall-gear-1280.jpg";
const benefitsImage =
  membershipPage.benefitsImage ||
  toPublicUrl(membershipPage.benefitsImageLibraryPath) ||
  "/images/canva-final/membership-climber-benefits-960.jpg";

const toParagraphs = (text?: string) =>
  (text || "")
    .split(/\n{2,}/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);

// "$XX" in editable copy is a placeholder for the live prorated price, so any
// headline containing it gets the real component spliced in at that spot.
const splitOnPricePlaceholder = (text?: string) => (text || "").split(/\$XX/i);

const manageParagraphs = toParagraphs(heroContent.subtext);
const billingParagraphs = toParagraphs(pricing.billingText);

const localDiscounts = membershipPage.localDiscounts || {
  headline: "LOCAL DISCOUNTS",
  intro:
    "Bring your member key tag to any of our local partners for a discount on your order! Click on the icons for address, hours, and more info.",
  partners15: [],
  partners10: [],
};
const discountTiers = [
  { label: "15%", partners: localDiscounts.partners15 || [] },
  { label: "10%", partners: localDiscounts.partners10 || [] },
].filter((tier) => tier.partners.length > 0);
const bottomCta = membershipPage.bottomCta;
---

<BaseLayout title="Membership">
  <!-- Hero Section with Video -->
  <PageHero
    headline={heroContent.headline || "MEMBERSHIP"}
    backgroundImage={membershipHeroImage}
    backgroundVideo={membershipHeroVideo}
    imageAlt="Membership hero fallback background"
    objectPositionX={heroContent.objectPositionX}
    objectPositionY={heroContent.objectPositionY}
  />

  <!-- Manage Your Membership Section -->
  <section class="page-section">
    <div class="section-inner manage-container">
      <div class="manage-copy">
        <h2 class="section-heading">
          {manageSection.headline || "MANAGE YOUR MEMBERSHIP"}
        </h2>
        {manageParagraphs.map((paragraph) => <p class="section-copy">{paragraph}</p>)}
        <a
          href={portalButton.url || "https://portal.climbtheknot.com"}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-button"
        >
          {portalButton.text || "REDPOINT MEMBER PORTAL"}
        </a>
      </div>
      <div class="manage-image">
        <img
          src={manageImage}
          alt="Climbing wall with gear and holds"
          loading="lazy"
          decoding="async"
          width="1280"
          height="721"
        />
      </div>
    </div>
  </section>

  <!-- Billing Section -->
  <section class="page-section">
    <div class="section-inner">
      <h2 class="section-heading">{pricing.sectionHeading || "BILLING"}</h2>
      {
        pricing.headline && (
          <p class="billing-lead">
            {splitOnPricePlaceholder(pricing.headline).map((part, index) => (
              <>
                {index > 0 && <ProratedMembershipPrice color={colors.manatee} />}
                {part}
              </>
            ))}
          </p>
        )
      }
      {
        billingParagraphs.map((paragraph) => (
          <p class="section-copy">
            {paragraph.split(/(\$\d+)/).map((segment) =>
              /^\$\d+$/.test(segment) ? (
                <span class="billing-amount">{segment}</span>
              ) : (
                segment
              ),
            )}
          </p>
        ))
      }
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="page-section" id="benefits">
    <div class="section-inner">
      <h2 class="section-heading">MEMBER BENEFITS</h2>
      <div class="benefits-card">
        <ul class="benefits-items">
          {
            benefits.map((benefit) => (
              <li class="benefit-item">
                <div class="benefit-check">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
                    <circle
                      cx="12"
                      cy="12"
                      r="11"
                      stroke="#000"
                      stroke-width="1.5"
                      fill="none"
                    />
                    <path
                      d="M7 12l3 3 7-7"
                      stroke="#000"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </div>
                <div class="benefit-text">
                  <span class="benefit-title">{benefit.title}</span>
                  {benefit.description && (
                    <span class="benefit-description">
                      {benefit.description}
                    </span>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
        <div class="benefits-image">
          <img
            src={benefitsImage}
            alt="Climber enjoying membership benefits"
            loading="lazy"
            decoding="async"
            width="960"
            height="1440"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Local Discounts Section -->
  <section class="page-section">
    <div class="section-inner">
      <h2 class="section-heading">
        {localDiscounts.headline || "LOCAL DISCOUNTS"}
      </h2>
      {
        localDiscounts.intro && (
          <p class="section-copy discounts-intro">{localDiscounts.intro}</p>
        )
      }

      {
        discountTiers.map((tier) => (
          <div class="discount-tier">
            <h3 class="tier-label">{tier.label}</h3>
            <div class="business-grid">
              {tier.partners.map((partner) => (
                <button
                  class="business-card"
                  data-business={JSON.stringify(partner)}
                >
                  <div class="business-image">
                    {partner.image ? (
                      <img
                        src={partner.image}
                        alt={partner.name}
                        width="120"
                        height="120"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
                        <rect
                          x="10"
                          y="20"
                          width="40"
                          height="30"
                          rx="2"
                          fill="rgba(255,255,255,0.3)"
                        />
                        <rect
                          x="20"
                          y="10"
                          width="20"
                          height="15"
                          rx="2"
                          fill="rgba(255,255,255,0.2)"
                        />
                      </svg>
                    )}
                  </div>
                  <span class="business-name">{partner.name}</span>
                </button>
              ))}
            </div>
          </div>
        ))
      }

      <!-- Business Detail Popup (populated + toggled by script) -->
      <div class="business-detail" id="businessDetail" hidden>
        <button
          type="button"
          class="business-detail-close"
          id="businessDetailClose"
          aria-label="Close business details"
        >
          &times;
        </button>
        <div class="business-detail-image" id="detailImageWrap">
          <img id="detailImage" src="" alt="" hidden />
        </div>
        <div class="business-detail-info">
          <h3 class="business-detail-name" id="detailName"></h3>
          <a
            class="business-detail-handle"
            id="detailHandle"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            hidden></a>
          <p class="business-detail-description" id="detailDescription"></p>
          <div class="business-detail-field" id="detailAddressWrap" hidden>
            <h4>ADDRESS</h4>
            <p id="detailAddress"></p>
          </div>
          <div class="business-detail-field" id="detailHoursWrap" hidden>
            <h4>HOURS</h4>
            <p id="detailHours"></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA Section -->
  {
    bottomCta && (
      <section class="page-section">
        <div class="section-inner">
          <h2 class="section-heading">
            {splitOnPricePlaceholder(bottomCta.headline).map((part, index) => (
              <>
                {index > 0 && <ProratedMembershipPrice color={colors.manatee} />}
                {part}
              </>
            ))}
          </h2>
          {toParagraphs(bottomCta.description).map((paragraph) => (
            <p class="section-copy">{paragraph}</p>
          ))}
          {bottomCta.buttonText && (
            <div class="bottom-cta-actions">
              <a
                href={bottomCta.buttonUrl || "https://portal.climbtheknot.com"}
                target="_blank"
                rel="noopener noreferrer"
                class="cta-button"
              >
                {bottomCta.buttonText}
              </a>
            </div>
          )}
        </div>
      </section>
    )
  }

  <script>
    interface BusinessData {
      name?: string;
      handle?: string;
      description?: string;
      address?: string;
      hours?: string;
      image?: string;
    }

    const detail = document.getElementById("businessDetail");
    const closeBtn = document.getElementById("businessDetailClose");
    const imageWrap = document.getElementById("detailImageWrap");
    const image = document.getElementById("detailImage") as HTMLImageElement | null;
    const nameEl = document.getElementById("detailName");
    const handleEl = document.getElementById("detailHandle") as HTMLAnchorElement | null;
    const descEl = document.getElementById("detailDescription");
    const addressWrap = document.getElementById("detailAddressWrap");
    const addressEl = document.getElementById("detailAddress");
    const hoursWrap = document.getElementById("detailHoursWrap");
    const hoursEl = document.getElementById("detailHours");
    const cards = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".business-card"),
    );

    const setField = (
      wrap: HTMLElement | null,
      target: HTMLElement | null,
      value?: string,
    ) => {
      if (!wrap || !target) return;
      if (value) {
        target.textContent = value;
        wrap.hidden = false;
      } else {
        target.textContent = "";
        wrap.hidden = true;
      }
    };

    const openDetail = (data: BusinessData) => {
      if (!detail) return;

      if (nameEl) nameEl.textContent = data.name || "";

      if (image && imageWrap) {
        if (data.image) {
          image.src = data.image;
          image.alt = data.name || "";
          image.hidden = false;
        } else {
          image.removeAttribute("src");
          image.hidden = true;
        }
      }

      if (handleEl) {
        if (data.handle) {
          const clean = data.handle.replace(/^@/, "").trim();
          handleEl.href = `https://www.instagram.com/${clean}/`;
          handleEl.textContent = data.handle.startsWith("@")
            ? data.handle
            : `@${clean}`;
          handleEl.hidden = false;
        } else {
          handleEl.hidden = true;
        }
      }

      if (descEl) descEl.textContent = data.description || "";

      setField(addressWrap, addressEl, data.address);
      setField(hoursWrap, hoursEl, data.hours);

      detail.hidden = false;
      detail.scrollIntoView({ behavior: "smooth", block: "nearest" });
    };

    const closeDetail = () => {
      if (detail) detail.hidden = true;
    };

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        const raw = card.dataset.business;
        if (!raw) return;
        try {
          openDetail(JSON.parse(raw) as BusinessData);
        } catch {
          /* ignore malformed data */
        }
      });
    });

    closeBtn?.addEventListener("click", closeDetail);

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && detail && !detail.hidden) closeDetail();
    });

    document.addEventListener("click", (event) => {
      if (!detail || detail.hidden) return;
      const target = event.target as Node;
      if (detail.contains(target)) return;
      if (cards.some((card) => card.contains(target))) return;
      closeDetail();
    });
  </script>
</BaseLayout>

<style>
  /* Every section below the hero shares one black canvas, one content width,
     and one vertical rhythm so the page reads as a single column. */
  .page-section {
    padding: 36px 48px;
    background-color: #000;
  }

  .section-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .section-heading {
    font-family: var(--font-heading, "Zing Rust", sans-serif);
    font-size: clamp(24px, 3.6vw, 44px);
    font-weight: 900;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.1;
    margin: 0 0 28px 0;
  }

  /* Named to avoid colliding with the global .body-text utility, whose design
     tokens force weight 700 and italic. */
  .section-copy {
    font-family: var(--font-body, "Rubik", sans-serif);
    font-size: 16px;
    font-weight: 400;
    font-style: normal;
    color: #fff;
    line-height: 1.7;
    margin: 0 0 20px 0;
  }

  .section-copy:last-of-type {
    margin-bottom: 0;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 48px;
    background-color: var(--color-manatee, #84babf);
    color: #000;
    font-family: var(--font-heading, "Uniform Pro", sans-serif);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 1px;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .cta-button:hover {
    opacity: 0.85;
  }

  /* Manage Your Membership */
  .manage-container {
    display: flex;
    align-items: center;
    gap: 64px;
  }

  .manage-copy {
    flex: 1 1 0;
    min-width: 0;
  }

  .manage-copy .cta-button {
    margin-top: 32px;
  }

  .manage-image {
    flex: 0 1 620px;
    min-width: 0;
  }

  .manage-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
  }

  /* Billing */
  .billing-lead {
    font-family: var(--font-heading, "Uniform Pro", sans-serif);
    font-size: 17px;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 20px 0;
  }

  .billing-amount {
    color: var(--color-manatee, #84babf);
  }

  /* Benefits */
  .benefits-card {
    display: flex;
    align-items: stretch;
    background-color: var(--color-sand, #faf9f5);
    border-radius: 16px;
    overflow: hidden;
  }

  .benefits-items {
    flex: 1 1 0;
    min-width: 0;
    list-style: none;
    padding: 48px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .benefit-check {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .benefit-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .benefit-title {
    font-family: var(--font-heading, "Uniform Pro", sans-serif);
    font-size: 14px;
    font-weight: 700;
    color: #000;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .benefit-description {
    font-family: var(--font-body, "Rubik", sans-serif);
    font-size: 13px;
    color: #444;
    line-height: 1.5;
  }

  .benefits-image {
    flex: 0 0 42%;
  }

  .benefits-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Local Discounts */
  .discounts-intro {
    margin-bottom: 40px;
  }

  .discount-tier {
    margin-bottom: 48px;
  }

  .discount-tier:last-of-type {
    margin-bottom: 0;
  }

  .tier-label {
    font-family: var(--font-heading, "Zing Rust", sans-serif);
    font-size: 52px;
    font-weight: 900;
    color: var(--color-manatee, #84babf);
    margin: 0 0 24px 0;
    line-height: 1.1;
  }

  .business-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
  }

  .business-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 150px;
    padding: 0;
    background-color: #fff;
    border: none;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .business-card:hover {
    transform: scale(1.05);
  }

  .business-image {
    height: 120px;
    background: linear-gradient(135deg, #2a2a2a 0%, #3a3a3a 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    filter: grayscale(100%);
  }

  .business-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .business-name {
    padding: 12px 8px;
    font-family: var(--font-heading, "Uniform Pro", sans-serif);
    font-size: 13px;
    font-weight: 700;
    color: #000;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: 0.5px;
    line-height: 1.3;
  }

  .business-detail {
    display: flex;
    position: relative;
    margin: 48px auto 0;
    background-color: var(--color-sand, #faf9f5);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }

  .business-detail[hidden] {
    display: none;
  }

  .business-detail-close {
    position: absolute;
    top: 12px;
    right: 16px;
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    color: #333;
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
  }

  .business-detail-close:hover {
    color: var(--color-rust, #b94237);
  }

  .business-detail-image {
    flex: 0 0 40%;
    align-self: stretch;
    min-height: 340px;
    background: linear-gradient(180deg, #cfe8f5 0%, #dff0d8 55%, #7cb342 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    filter: grayscale(100%);
  }

  .business-detail-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .business-detail-info {
    flex: 1;
    padding: 48px 56px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .business-detail-name {
    font-family: var(--font-heading, "Zing Rust", sans-serif);
    font-size: 48px;
    font-weight: 900;
    color: #000;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.05;
  }

  .business-detail-handle {
    font-family: var(--font-heading, "Uniform Pro", sans-serif);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-rust, #b94237);
    text-decoration: none;
    width: fit-content;
  }

  .business-detail-handle:hover {
    text-decoration: underline;
  }

  .business-detail-description {
    font-family: var(--font-body, "Rubik", sans-serif);
    font-size: 16px;
    color: #333;
    line-height: 1.6;
    margin: 0;
  }

  .business-detail-field {
    margin-top: 8px;
  }

  .business-detail-field[hidden] {
    display: none;
  }

  .business-detail-field h4 {
    font-family: var(--font-heading, "Uniform Pro", sans-serif);
    font-size: 15px;
    font-weight: 700;
    color: #000;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 4px 0;
  }

  .business-detail-field p {
    font-family: var(--font-body, "Rubik", sans-serif);
    font-size: 16px;
    color: #333;
    margin: 0;
  }

  /* Bottom CTA */
  .bottom-cta-actions {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

