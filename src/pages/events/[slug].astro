---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { isRecurringSchedule, recurringScheduleLines } from '../../lib/eventSchedule';

export async function getStaticPaths() {
  const events = await getCollection('events');
  // Only events the editor has opted into get a dedicated page; others show
  // only their inline info block on the Events index.
  return events
    .filter((event) => event.data.eventPage?.discriminant === true)
    .map((event) => ({
      params: { slug: event.id },
      props: { event },
    }));
}

const { event } = Astro.props;

if (!event) {
  throw new Error('Event content missing for /events/[slug].');
}

const eventData = event.data;
const eventTitle = eventData.title;

const toPublicUrl = (libraryPath?: string | null) =>
  libraryPath && libraryPath.startsWith('public/')
    ? `/${libraryPath.slice('public/'.length)}`
    : undefined;

// Events with no image of their own fall back to the Events index hero, so the
// dedicated page still reads as part of the events section.
const eventsHeroImage = '/images/canva-final/photos/events-hero.jpg';
const eventImage =
  toPublicUrl(eventData.imageLibraryPath) || eventData.image || eventsHeroImage;

const flyerData = eventData.eventPage?.value;
// The Media Library pick wins. `flyer` is the pre-library upload value, kept
// only so events that were never migrated still render.
const flyerImage = toPublicUrl(flyerData?.flyerLibraryPath) || flyerData?.flyer || undefined;

function formatDate(dateString: string | undefined): string {
  if (!dateString) return 'Date TBD';
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

// Render a single date, or a "start – end" range when an end date is set.
function formatDateRange(start: string | undefined, end?: string): string {
  if (!end) return formatDate(start);
  return `${formatDate(start)} – ${formatDate(end)}`;
}

const isRecurring = isRecurringSchedule(eventData.recurring);
// End date applies to non-recurring events only.
const eventEndDate = isRecurring ? undefined : eventData.endDate;
const recurringLines = recurringScheduleLines(eventData.recurring);

const hasRegistration = !!eventData.registrationLink;

// Render a plain text block with simple **bold** support. HTML is escaped first
// so staff-entered content can't inject markup; line breaks are preserved by the
// `white-space: pre-line` style on the container.
function renderRichText(text?: string): string {
  if (!text) return '';
  const escaped = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  return escaped.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}
---

<BaseLayout title={eventTitle}>
  <!-- Hero Section: the shared secondary-page hero, so event pages match
       About, Amenities, Membership, and the Events index exactly. -->
  <PageHero
    headline={eventTitle.toUpperCase()}
    backgroundImage={eventImage}
    imageAlt={eventTitle}
  />

  <!-- Flyer + Details Block (dedicated-page events with a flyer image) -->
  {flyerImage && (
    <section class="flyer-section">
      <div class="flyer-card">
        <img
          src={flyerImage}
          alt={`${eventTitle} flyer`}
          class="flyer-image"
          loading="lazy"
          decoding="async"
        />
        <div class="flyer-content">
          <h2 class="flyer-title">{eventTitle.toUpperCase()}</h2>
          <p class="flyer-meta">
            {formatDateRange(eventData.date, eventEndDate)}{" "}
            {eventData.time ? `| ${eventData.time}` : ""}
          </p>
          {eventData.description && (
            <p class="flyer-description">{eventData.description}</p>
          )}
          {isRecurring && recurringLines.length > 0 && (
            <div class="recurring-info">
              <span class="recurring-badge">Recurring Event</span>
              {recurringLines.map((line) => <p>{line}</p>)}
            </div>
          )}
          {hasRegistration && (
            <div class="flyer-actions">
              <a
                href={eventData.registrationLink}
                target="_blank"
                rel="noopener noreferrer"
                class="flyer-button"
              >
                REGISTRATION
              </a>
            </div>
          )}
          <p class="flyer-address">
            <strong>ADDRESS</strong>
            <br />
            {eventData.address ? eventData.address : "704 S Main St, Gainesville, FL 32601"}
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- Event Details Section (when there's no flyer block) -->
  {!flyerImage && (
    <section class="details-section">
    <div class="details-container">
      <div class="event-description">
        {eventData.description && (
          <div class="description-text">
            <p>{eventData.description}</p>
          </div>
        )}

        {isRecurring && recurringLines.length > 0 && (
          <div class="recurring-info">
            <span class="recurring-badge">Recurring Event</span>
            {recurringLines.map((line) => <p>{line}</p>)}
          </div>
        )}
      </div>

      <div class="event-sidebar">
        <div class="event-info-card">
          <h3>Event Details</h3>
          
          <div class="info-item">
            <span class="info-label">{isRecurring ? 'Start Date' : 'Date'}</span>
            <span class="info-value">{formatDateRange(eventData.date, eventEndDate)}</span>
          </div>

          {eventData.time && (
            <div class="info-item">
              <span class="info-label">Time</span>
              <span class="info-value">{eventData.time}</span>
            </div>
          )}

          <div class="info-item">
            <span class="info-label">Location</span>
            <span class="info-value">The Knot Climbing Gym<br />{eventData.address ? eventData.address : '704 S Main St, Gainesville, FL 32601'}</span>
          </div>

          {hasRegistration && (
            <a
              href={eventData.registrationLink}
              target="_blank"
              rel="noopener noreferrer"
              class="register-button"
            >
              REGISTER NOW
            </a>
          )}
        </div>
      </div>
    </div>
    </section>
  )}

  <!-- Optional Extended Sections -->
  {eventData.competitionDivisions && eventData.competitionDivisions.length > 0 && (
    <section class="extended-section">
      <div class="extended-container">
        <div class="divisions-list">
          {eventData.competitionDivisions.map((div: { name: string; description?: string; buttons?: { text?: string; url?: string }[] }) => {
            const divButtons = (div.buttons ?? []).filter((button) => button.url);
            return (
              <div class="division-card">
                <div class="division-header">
                  <h3 class="division-name">{div.name}</h3>
                </div>
                {(div.description || divButtons.length > 0) && (
                  <div class="division-body">
                    {div.description && <p class="division-description">{div.description}</p>}
                    {divButtons.length > 0 && (
                      <div class="division-buttons">
                        {divButtons.map((button) => (
                          <a
                            href={button.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="division-button"
                          >
                            {button.text || 'REGISTER'}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {eventData.schedule && eventData.schedule.length > 0 && (
    <section class="extended-section">
      <div class="extended-container">
        <h2 class="extended-heading">EVENT SCHEDULE</h2>
        <div class="schedule-accordion">
          {eventData.schedule.map((section: { title?: string; content?: string; openByDefault?: boolean }) => (
            <details class="schedule-section" open={section.openByDefault}>
              <summary class="schedule-summary">
                <span class="schedule-section-title">{section.title}</span>
                <span class="schedule-chevron" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path
                      d="M6 9L12 15L18 9"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </summary>
              {section.content && (
                <div class="schedule-section-body" set:html={renderRichText(section.content)} />
              )}
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {eventData.faqItems && eventData.faqItems.length > 0 && (
    <section class="extended-section">
      <div class="extended-container">
        <h2 class="extended-heading">FAQ</h2>
        <div class="faq-list">
          {eventData.faqItems.map((faq: { question?: string; answer?: string }) => (
            <details class="faq-item">
              <summary class="faq-summary">
                <span class="faq-question">{faq.question}</span>
                <span class="faq-chevron" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path
                      d="M6 9L12 15L18 9"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </summary>
              {faq.answer && (
                <div class="faq-answer" set:html={renderRichText(faq.answer)} />
              )}
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {eventData.merchandise && eventData.merchandise.length > 0 && (
    <section class="extended-section">
      <div class="extended-container">
        <h2 class="extended-heading">MERCHANDISE</h2>
        <div class="merch-grid">
          {eventData.merchandise.map((item: { name: string; description?: string; price?: string; preorderLink?: string }) => (
            <div class="merch-card">
              <h3 class="merch-name">{item.name}</h3>
              {item.description && <p class="merch-description">{item.description}</p>}
              {item.price && <p class="merch-price">{item.price}</p>}
              {item.preorderLink && (
                <a href={item.preorderLink} target="_blank" rel="noopener noreferrer" class="merch-link">
                  PRE-ORDER NOW
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Back to Events -->
  <section class="back-section">
    <a href="/events" class="back-link">
      &larr; Back to All Events
    </a>
  </section>
</BaseLayout>

<style>
  /* Flyer + Details Block */
  .flyer-section {
    padding: 60px var(--page-padding-x);
    background: #000;
  }

  .flyer-card {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 3fr 7fr;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-sand);
  }

  .flyer-image {
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
    display: block;
  }

  .flyer-content {
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .flyer-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 900;
    color: var(--color-graphite);
    text-transform: uppercase;
    line-height: 1;
  }

  .flyer-meta {
    margin: 0;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-rust);
  }

  .flyer-description {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--body-size);
    line-height: 1.7;
    color: var(--color-graphite);
  }

  .flyer-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .flyer-button {
    display: inline-block;
    padding: 14px 28px;
    background: var(--color-rust);
    color: #fff;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    transition: opacity 0.2s ease;
  }

  .flyer-button:hover {
    opacity: 0.9;
  }

  .flyer-address {
    margin: auto 0 0;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-graphite);
  }

  /* Details Section */
  .details-section {
    padding: 60px var(--page-padding-x);
    background: white;
  }

  .details-container {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 60px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .event-description {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .description-text p {
    font-family: var(--font-body);
    font-size: var(--body-size);
    line-height: 1.8;
    color: var(--color-graphite);
    margin: 0;
  }

  .recurring-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .recurring-badge {
    display: inline-block;
    background: var(--color-limestone);
    color: var(--color-graphite);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 4px;
    width: fit-content;
  }

  .recurring-info p {
    font-family: var(--font-body);
    font-size: var(--body-size);
    color: var(--color-graphite);
    margin: 0;
  }

  .event-sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .event-info-card {
    background: var(--color-sand);
    padding: 32px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .event-info-card h3 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--color-graphite);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .info-label {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-graphite);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    opacity: 0.6;
  }

  .info-value {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-graphite);
    line-height: 1.5;
  }

  .register-button {
    display: block;
    width: 100%;
    padding: 16px 24px;
    background: var(--color-rust);
    color: white;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
    margin-top: 8px;
  }

  .register-button:hover {
    opacity: 0.9;
  }

  /* Back Section */
  .back-section {
    padding: 40px var(--page-padding-x);
    background: white;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-rust);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .back-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* Extended Sections (Divisions, Schedule, FAQ, Merchandise) */
  .extended-section {
    padding: 48px var(--page-padding-x);
    background: #000;
  }

  .extended-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .extended-heading {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3.6vw, 44px);
    font-weight: 900;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 24px 0;
  }

  /* Divisions
     Borrows the shared Accordion's header/panel look so the page reads as one
     system, but stays a plain always-open block — no toggle, so no hover state
     and no chevron. */
  .divisions-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .division-card {
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0;
    overflow: hidden;
  }

  .division-header {
    background: var(--color-graphite, #39393b);
    padding: 20px 24px;
  }

  .division-name {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0;
    margin: 0;
  }

  .division-body {
    padding: 24px 40px;
    background: rgba(57, 57, 59, 0.5);
  }

  .division-description {
    font-family: var(--font-body);
    font-size: var(--body-size);
    color: #fff;
    line-height: 1.6;
    margin: 0;
  }

  .division-buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 20px;
  }

  .division-button {
    display: inline-block;
    padding: 14px 28px;
    background: var(--color-rust);
    color: #fff;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .division-button:hover {
    opacity: 0.9;
  }

  /* Schedule (accordion)
     Mirrors the shared Accordion component (src/components/Accordion.tsx):
     graphite headers, square corners, 8px stack gap, manatee chevron, and a
     half-opacity graphite panel. It stays a native <details> rather than the
     React component because the schedule copy relies on **bold** markup, which
     the shared accordion doesn't parse. */
  .schedule-accordion {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .schedule-section {
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0;
    overflow: hidden;
  }

  .schedule-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    background: var(--color-graphite, #39393b);
    cursor: pointer;
    list-style: none;
    transition: background-color 0.2s ease;
  }

  .schedule-summary:hover,
  .schedule-section[open] .schedule-summary {
    background: #4a4a4c;
  }

  .schedule-summary::-webkit-details-marker {
    display: none;
  }

  .schedule-section-title {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0;
    text-align: left;
  }

  .schedule-chevron {
    display: flex;
    align-items: center;
    color: var(--color-manatee, #84babf);
    transition: transform 0.3s ease;
  }

  .schedule-section[open] .schedule-chevron {
    transform: rotate(180deg);
  }

  .schedule-section-body {
    padding: 24px 40px;
    background: rgba(57, 57, 59, 0.5);
    font-family: var(--font-body);
    font-size: var(--body-size);
    color: #fff;
    line-height: 1.6;
    white-space: pre-line;
  }

  /* FAQ (accordion) — same shared-Accordion treatment as the schedule above. */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .faq-item {
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0;
    overflow: hidden;
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    background: var(--color-graphite, #39393b);
    cursor: pointer;
    list-style: none;
    transition: background-color 0.2s ease;
  }

  .faq-summary:hover,
  .faq-item[open] .faq-summary {
    background: #4a4a4c;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-question {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0;
    text-align: left;
  }

  .faq-chevron {
    display: flex;
    align-items: center;
    color: var(--color-manatee, #84babf);
    transition: transform 0.3s ease;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 24px 40px;
    background: rgba(57, 57, 59, 0.5);
    font-family: var(--font-body);
    font-size: var(--body-size);
    color: #fff;
    line-height: 1.6;
    white-space: pre-line;
  }

  /* Merchandise */
  .merch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .merch-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .merch-name {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    margin: 0;
  }

  .merch-description {
    font-family: var(--font-body);
    font-size: var(--body-size);
    color: #ddd;
    line-height: 1.6;
    margin: 0;
  }

  .merch-price {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: #84babf;
    margin: 0;
  }

  .merch-link {
    display: inline-block;
    padding: 12px 24px;
    background: var(--color-rust);
    color: #fff;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    border-radius: 0;
    transition: opacity 0.2s ease;
    width: fit-content;
  }

  .merch-link:hover {
    opacity: 0.9;
  }

  /* Mobile Responsive */
  @media (max-width: 900px) {
    .details-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .event-sidebar {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    /* Same mobile padding step-down the shared Accordion uses. */
    .schedule-summary,
    .faq-summary,
    .division-header {
      padding: 16px 20px;
    }

    .schedule-section-body,
    .faq-answer,
    .division-body {
      padding: 20px 28px;
    }

    .details-section {
      padding: 40px var(--page-padding-x);
    }

    .flyer-card {
      grid-template-columns: 1fr;
    }

    .flyer-content {
      padding: 28px;
    }

    .event-info-card {
      padding: 24px;
    }

    .back-section {
      padding: 30px var(--page-padding-x);
    }
  }
</style>
