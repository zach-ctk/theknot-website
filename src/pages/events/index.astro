---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Accordion from "../../components/Accordion.tsx";
import { getCollection } from "astro:content";
import fs from "node:fs";
import path from "node:path";
import {
  isRecurringSchedule,
  recurringScheduleLines,
} from "../../lib/eventSchedule";

const hillsPlaceholder = "/images/canva-final/canva-hills-background.jpg";
const eventsHeroImage = "/images/canva-final/photos/events-hero.jpg";
const upendingParkinsonsImage =
  "/images/canva-final/photos/events-upending-parkinsons.jpg";
const redpointEventsUrl = "https://portal.climbtheknot.com/gnv/events";

// Load business info for the events email and the gym's own street address.
// Keystatic frames an event's address as "if different from gym", so events
// that leave it blank fall back to the gym address here.
let eventsEmail = "events@climbtheknot.com";
let gymAddress = "704 S Main St";
try {
  const biPath = path.join(process.cwd(), "src/content/business-info.json");
  const raw = fs.readFileSync(biPath, "utf-8");
  const parsed = JSON.parse(raw);
  if (parsed?.contact?.eventsEmail) eventsEmail = parsed.contact.eventsEmail;
  if (parsed?.address?.street) gymAddress = parsed.address.street;
} catch (e) {
  // Use defaults
}

function parseDate(value?: string): Date | null {
  if (!value) return null;
  const parsed = new Date(value);
  return Number.isNaN(parsed.getTime()) ? null : parsed;
}

function formatDate(value?: string): string {
  const parsed = parseDate(value);
  if (!parsed) return "Date TBD";
  return parsed.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

// Render a single date, or a "start – end" range when an end date is set.
function formatDateRange(start?: string, end?: string): string {
  if (!end) return formatDate(start);
  return `${formatDate(start)} – ${formatDate(end)}`;
}

const allEvents = (await getCollection("events")).sort((left, right) => {
  const leftDate = parseDate(left.data.date);
  const rightDate = parseDate(right.data.date);

  if (!leftDate && !rightDate) return 0;
  if (!leftDate) return 1;
  if (!rightDate) return -1;
  return leftDate.getTime() - rightDate.getTime();
});

const now = new Date();
now.setHours(0, 0, 0, 0);

const isRecurring = (event: (typeof allEvents)[number]) =>
  isRecurringSchedule(event.data.recurring);

// Recurring events render as Upending-style blocks at the bottom of the page,
// not as calendar cards, and show regardless of their start date.
const recurringEvents = allEvents.filter(isRecurring);

// One-time, upcoming events only — these become the calendar cards and the
// "Our Next Event" feature. Recurring events are excluded here.
const upcomingEvents = allEvents.filter((event) => {
  if (isRecurring(event)) return false;
  const eventDate = parseDate(event.data.date);
  return !eventDate || eventDate.getTime() >= now.getTime();
});

const featuredEvent =
  upcomingEvents.find((event) => event.data.isFeatured) ??
  upcomingEvents[0] ??
  null;

// The next-event button points at the event's own page when it has one, so the
// visitor lands on the full details rather than the portal's event list. Events
// without a dedicated page fall back to their registration link, then to the
// portal.
const featuredEventUrl = featuredEvent
  ? (featuredEvent.data.eventPage?.discriminant
      ? `/events/${featuredEvent.id}`
      : featuredEvent.data.registrationLink || redpointEventsUrl)
  : redpointEventsUrl;

const featuredEventIsExternal = !featuredEventUrl.startsWith("/");

const toPublicUrl = (libraryPath?: string | null) =>
  libraryPath && libraryPath.startsWith("public/")
    ? `/${libraryPath.slice("public/".length)}`
    : undefined;

// Library pick first, legacy upload value second: uploads no longer exist as CMS
// fields, so the second term only covers content that predates the migration.
const eventImage = (event: (typeof allEvents)[number]) =>
  toPublicUrl(event.data.imageLibraryPath) ||
  event.data.image ||
  hillsPlaceholder;

// The flyer is the primary image everywhere on the events index (cards, next
// event, detail blocks). Falls back to the event image, then the placeholder.
// The event image itself is only used as the hero on the dedicated event page.
const cardImage = (event: (typeof allEvents)[number]) => {
  const flyer = event.data.eventPage?.value;
  return (
    toPublicUrl(flyer?.flyerLibraryPath) || flyer?.flyer || eventImage(event)
  );
};

const eventParagraphs = (description?: string) =>
  (description ?? "")
    .split(/\n+/)
    .map((line) => line.trim())
    .filter(Boolean);

// Pricing, length, and group size come from the group events cheat sheet.
// Each entry follows the same shape: a short description, then LENGTH / PRICE /
// GROUP SIZE as "## Label" blocks (rendered as red headings by Accordion.tsx),
// then any booking requirements.
const eventTypeItems = [
  {
    title: "BOULDERING ONLY",
    content:
      "Bouldering is climbing without ropes on shorter walls with thick crash pads below. Great for first-time climbers and larger group events.\n\n## LENGTH\n2 hours\n\n## PRICE\n$200 for up to 8 climbers, then $15 per additional climber\n\n## GROUP SIZE\n8 - 30 climbers (max 20 for youth groups)",
  },
  {
    title: "TOP ROPE + BOULDERING",
    content:
      "Top rope events include harnesses and rope climbing lanes in addition to bouldering zones.\n\n## LENGTH\n2 hours\n\n## PRICE\n$200 for up to 8 climbers, then $15 per additional climber\n\n## GROUP SIZE\n8 - 30 climbers (max 20 for youth groups)\n\nAll belayers must be certified at The Knot. If your group plans to bring its own belayers, they will need to pass a belay check-off at our facility before the event.",
  },
  {
    title: "STAFF BELAY",
    content:
      "Need belayers? The Knot can provide trained staff belayers for private and corporate events when scheduled in advance.\n\n## LENGTH\n1 - 2 hours\n\n## PRICE\n$100 for up to 4 climbers, then $20 per additional climber\n\n## GROUP SIZE\n4 - 20 climbers",
  },
  {
    title: "YOGA OR FITNESS CLASS",
    content:
      "Add a private yoga or fitness session to your event package.\n\n## LENGTH\n1 hour\n\n## PRICE\n$150 per class\n\n## GROUP SIZE\nUp to 10 participants\n\nPrivate classes are subject to instructor availability.",
  },
  {
    title: "BELAY CLASS",
    content:
      "Belay classes can be added for groups that want certification as part of the event experience.\n\n## LENGTH\n2 hours\n\n## PRICE\n$200 per class\n\n## GROUP SIZE\nUp to 4 participants",
  },
  {
    title: "KIDS POLICIES",
    content:
      "Youth participants must follow age and supervision requirements. Contact staff for current youth policy details before booking.",
  },
];
---

<BaseLayout title="Events">
  <PageHero headline="EVENTS" backgroundImage={eventsHeroImage} />

  <section class="next-event-section">
    <div class="next-event-grid">
      <div class="next-event-main">
        <h2 class="section-title">OUR NEXT EVENT</h2>
        {
          featuredEvent ? (
            <>
              <h3 class="event-title">{featuredEvent.data.title}</h3>
              <p class="event-meta">
                {formatDateRange(featuredEvent.data.date, featuredEvent.data.endDate)}{" "}
                {featuredEvent.data.time ? `| ${featuredEvent.data.time}` : ""}
              </p>
              <p class="event-description">
                {featuredEvent.data.description ?? "Details coming soon."}
              </p>

              <a
                href={featuredEventUrl}
                target={featuredEventIsExternal ? "_blank" : undefined}
                rel={featuredEventIsExternal ? "noopener noreferrer" : undefined}
                class="btn-secondary next-event-button"
              >
                REGISTRATION & MORE INFO
              </a>
            </>
          ) : (
            <p class="event-description">No upcoming events</p>
          )
        }
      </div>

      {featuredEvent && (
        <img
          src={cardImage(featuredEvent)}
          alt={featuredEvent.data.title}
          class="next-event-image"
        />
      )}
    </div>
  </section>

  <section class="calendar-section">
    <div class="section-inner">
    <h2 class="section-title">EVENT CALENDAR</h2>
    <p class="section-subtext">
      We host events almost every month. Click any event to learn more.
    </p>

    <div class="calendar-grid">
      {
        upcomingEvents.length > 0 ? (
          upcomingEvents.map((event) => (
            <button
              type="button"
              class="calendar-card"
              data-event-target={event.id}
              aria-expanded="false"
              aria-controls={`event-detail-${event.id}`}
            >
              <img
                src={cardImage(event)}
                alt={event.data.title}
                class="calendar-card-image"
                loading="lazy"
                decoding="async"
              />
              <div class="calendar-card-body">
                <h3 class="calendar-card-title">{event.data.title}</h3>
                <p class="calendar-card-date">{formatDateRange(event.data.date, event.data.endDate)}</p>
              </div>
            </button>
          ))
        ) : (
          <p class="calendar-empty">No upcoming events yet.</p>
        )
      }
    </div>

    {upcomingEvents.length > 0 && (
      <div class="event-detail-panel">
        {upcomingEvents.map((event) => (
          <article id={`event-detail-${event.id}`} class="event-detail" hidden>
            <button
              type="button"
              class="event-detail-close"
              data-event-close
              aria-label="Close event details"
            >
              &times;
            </button>
            <div class="event-detail-inner">
              <img
                src={cardImage(event)}
                alt={event.data.title}
                class="event-detail-image"
                loading="lazy"
                decoding="async"
              />
              <div class="event-detail-body">
                <h3 class="event-detail-title">{event.data.title}</h3>
                <p class="event-detail-meta">
                  {formatDateRange(event.data.date, event.data.endDate)}{" "}
                  {event.data.time ? `| ${event.data.time}` : ""}
                </p>
                {eventParagraphs(event.data.description).map((paragraph) => (
                  <p class="event-detail-description">{paragraph}</p>
                ))}
                <div class="event-detail-actions">
                  {event.data.eventPage?.discriminant && (
                    <a href={`/events/${event.id}`} class="btn-primary">
                      REGISTRATION
                    </a>
                  )}
                  {event.data.registrationLink && (
                    <a
                      href={event.data.registrationLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-primary"
                    >
                      REGISTRATION & MORE INFO
                    </a>
                  )}
                </div>
                <div class="event-detail-address-block">
                  <h4 class="event-detail-address-heading">ADDRESS</h4>
                  <p class="event-detail-address">
                    {event.data.address || gymAddress}
                  </p>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
    </div>
  </section>

  <section class="group-events-section">
    <div class="section-inner">
    <h2 class="section-title">GROUP EVENTS</h2>
    <p class="section-subtext">Host your next event with The Knot!</p>
    <h3 class="group-subtitle">EVENT TYPES & PRICING</h3>
    <Accordion items={eventTypeItems} client:visible align="left" />
    <p class="group-footnote group-footnote--lead">
      Group events must be scheduled at least three weeks in advance. Fill out
      our inquiry form or shoot us an email to learn more.
    </p>
    <p class="group-footnote">
      Group event scheduling is subject to gym and staff availability.
    </p>
    <div class="group-buttons">
      <a
        href="https://form.asana.com/?k=JDie6HSxcL5R1kJCgsb0iw&d=1199115976275379"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
      >
        EVENT REQUEST FORM
      </a>
      <a href={`mailto:${eventsEmail}`} class="btn-primary">CONTACT US</a>
    </div>
    </div>
  </section>

  {
    recurringEvents.map((event) => (
      <section class="upending-section">
        <div class="upending-grid">
          <div>
            <h2 class="section-title">{event.data.title}</h2>
            {eventParagraphs(event.data.description).map((paragraph) => (
              <p class="event-description">{paragraph}</p>
            ))}
            {recurringScheduleLines(event.data.recurring, " ").map((line) => (
              <p class="event-description">
                <strong>{line.toUpperCase()}</strong>
              </p>
            ))}
            {event.data.registrationLink && (
              <a
                href={event.data.registrationLink}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary register-button"
              >
                REGISTER HERE
              </a>
            )}
          </div>
          <img
            src={cardImage(event)}
            alt={event.data.title}
            class="upending-image"
            loading="lazy"
            decoding="async"
          />
        </div>
      </section>
    ))
  }

  <section class="upending-section">
    <div class="upending-grid">
      <div>
        <h2 class="section-title">UPENDING PARKINSONS</h2>
        <p class="event-description">
          The Knot is partnering with Up ENDing Parkinsons to provide guided
          climbing sessions for people living with Parkinson&apos;s Disease.
          Anyone living with PD is welcome to climb, and family members are
          encouraged to join.
        </p>
        <p class="event-description">
          <strong>WEDNESDAYS 10AM - 11:30AM</strong>
        </p>
        <p class="event-description">
          Admission, instruction, and rental gear are provided free of charge.
          No experience is required.
        </p>
        <a
          href="https://upendingparkinsons.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary register-button"
        >
          REGISTER HERE
        </a>
      </div>
      <img
        src={upendingParkinsonsImage}
        alt="Climber on top-rope at an Upending Parkinson's session"
        class="upending-image"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>
</BaseLayout>

<script>
  const cards = document.querySelectorAll<HTMLButtonElement>("[data-event-target]");
  const panels = document.querySelectorAll<HTMLElement>(".event-detail");

  function closeAll() {
    panels.forEach((panel) => (panel.hidden = true));
    cards.forEach((card) => card.setAttribute("aria-expanded", "false"));
  }

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      const id = card.getAttribute("data-event-target");
      const panel = document.getElementById(`event-detail-${id}`);
      if (!panel) return;

      // Clicking the active card again collapses it.
      const wasOpen = !panel.hidden;
      closeAll();
      if (!wasOpen) {
        panel.hidden = false;
        card.setAttribute("aria-expanded", "true");
        panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".event-detail-close").forEach((button) => {
    button.addEventListener("click", () => closeAll());
  });
</script>

<style>
  .next-event-section,
  .calendar-section,
  .group-events-section,
  .upending-section {
    padding: 48px var(--page-padding-x);
    background: #000;
  }

  /* Centers a section's content in the same 1200px column the grids use, so
     titles, subtext, and group-events content all share the page's alignment. */
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    margin: 0 0 12px;
    color: #fff;
    font-family: var(--font-heading);
    font-size: clamp(24px, 3.6vw, 44px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .section-subtext {
    margin: 0 0 20px;
    color: #ddd;
    font-family: var(--font-body);
    font-size: var(--body-size);
    line-height: 1.5;
  }

  .next-event-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    gap: 24px;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
  }

  .event-title {
    margin: 0 0 8px;
    color: #fff;
    font-family: var(--font-heading);
    font-size: clamp(18px, 2.6vw, 32px);
    text-transform: uppercase;
  }

  .event-meta,
  .event-description {
    margin: 0 0 12px;
    color: #e8e8e8;
    font-family: var(--font-body);
    font-size: var(--body-size);
    line-height: 1.6;
  }

  .next-event-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 6px;
  }

  .next-event-button {
    margin-top: 16px;
  }

  /* Mirrors the owners & managers grid on the about page: same 1200px column,
     same 24px gap, same wrap behavior, so the cards come out the same size. */
  .calendar-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
  }

  .calendar-card {
    display: block;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    overflow: hidden;
    background: #141414;
    color: inherit;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  button.calendar-card {
    /* 5 per row: subtract the 4 inter-card gaps (24px) from the grid, split 5
       ways — the same sizing the team cards use. */
    width: calc((100% - 4 * 24px) / 5);
    /* The card's 1px border sits inside that width, so the outer box matches
       the borderless team card exactly. */
    box-sizing: border-box;
    padding: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .calendar-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.5);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .event-detail-panel {
    max-width: 1200px;
    margin: 24px auto 0;
  }

  /* Black, not #141414, so any letterbox around the flyer reads as one solid
     column with the image's own backdrop. */
  .event-detail {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }

  /* No gap: the panel background would otherwise show through as a black
     stripe between the flyer and the white text box. The flyer column is auto
     so it takes exactly the width its capped height gives it — the text box
     absorbs the rest. */
  .event-detail-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
  }

  /* The flyer sets the panel's height. Left to its intrinsic size a portrait
     poster runs ~750px tall at this width and pushes the panel past a single
     screen, so the height is capped and the width follows from the aspect
     ratio — the whole flyer stays visible, uncropped. */
  .event-detail-image {
    width: auto;
    max-width: 100%;
    height: min(62vh, 545px);
    object-fit: contain;
    background: #000;
    display: block;
  }

  .event-detail-body {
    padding: 24px 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #fff;
  }

  .event-detail-title {
    margin: 0;
    color: #000;
    font-family: var(--font-heading);
    font-size: clamp(20px, 4vw, 28px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .event-detail-meta {
    margin: 0;
    color: var(--color-coral, #c97065);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
  }

  .event-detail-description {
    margin: 0;
    color: #000;
    font-family: var(--font-body);
    font-size: var(--body-size);
    line-height: 1.6;
  }

  /* auto top margin pins the actions to the bottom of the text box, so the
     buttons line up with the foot of the flyer regardless of copy length. */
  .event-detail-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: auto;
    padding-top: 8px;
  }

  /* Sits under the centered button but keeps the body's left alignment. The
     wrapper keeps the label tight to its value instead of taking the body's
     10px flex gap. */
  .event-detail-address-block {
    text-align: left;
  }

  .event-detail-address-heading {
    margin: 0 0 2px;
    color: #000;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .event-detail-address {
    margin: 0;
    color: #000;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
  }

  /* Compact version of the red button — the default padding/size is built for
     standalone section CTAs and reads oversized inside the panel. */
  .event-detail-actions .btn-primary {
    padding: 12px 22px;
    font-size: 13px;
  }

  .event-detail-close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    z-index: 1;
  }

  @media (max-width: 900px) {
    .event-detail-inner {
      grid-template-columns: 1fr;
    }

    /* Stacked, the flyer is narrower than the column, so center it and give
       the shorter viewport a smaller share of the screen. */
    .event-detail-image {
      justify-self: center;
      height: min(52vh, 440px);
    }
  }

  .calendar-card-image {
    width: 100%;
    aspect-ratio: 180 / 250;
    object-fit: cover;
    display: block;
  }

  .calendar-card-body {
    padding: 16px 8px;
  }

  .calendar-card-title {
    margin: 0 0 4px;
    color: #fff;
    font-family: var(--font-heading);
    font-size: 14px;
    text-transform: uppercase;
  }

  .calendar-card-date {
    margin: 0;
    color: #ccc;
    font-family: var(--font-body);
    font-size: 12px;
  }

  .calendar-empty {
    margin: 0;
    color: #ccc;
    font-family: var(--font-body);
  }

  /* Same breakpoint and single-column drop the team cards use. */
  @media (max-width: 768px) {
    .calendar-grid {
      gap: 16px;
    }

    button.calendar-card {
      width: 100%;
    }
  }

  .group-subtitle {
    margin: 0 0 14px;
    color: #fff;
    font-family: var(--font-heading);
    font-size: var(--body-size);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Two centered paragraphs. The lead one carries the gap off the accordion
     above plus a full blank line (1.6em = one line-height) before the second. */
  .group-footnote {
    margin: 0 0 20px;
    color: #cfcfcf;
    font-family: var(--font-body);
    font-size: var(--body-size);
    line-height: 1.6;
    text-align: center;
  }

  .group-footnote--lead {
    margin-top: 18px;
    margin-bottom: 1.6em;
  }

  /* Two equal columns with each button centered in its own column, so the pair
     reads as evenly spaced around the section's center line. */
  .group-buttons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    justify-items: center;
    gap: 16px;
    /* 30% narrower than the 1200px content column, which pulls the two
       centered buttons in toward each other on wide screens. */
    max-width: 840px;
    margin: 0 auto;
  }

  /* Compact sizing, in the spirit of the activity/FAQ buttons but with a
     slightly wider cap so "EVENT REQUEST FORM" fits on one line at the normal
     20px horizontal padding. */
  .group-buttons .btn-primary {
    width: 100%;
    max-width: 240px;
    box-sizing: border-box;
    padding: 16px 20px;
