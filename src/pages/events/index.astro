---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Accordion from "../../components/Accordion.tsx";
import { getCollection } from "astro:content";
import fs from "node:fs";
import path from "node:path";
import {
  isRecurringSchedule,
  recurringScheduleLines,
} from "../../lib/eventSchedule";

const hillsPlaceholder = "/images/canva-final/canva-hills-background.jpg";
const redpointEventsUrl = "https://portal.climbtheknot.com/gnv/events";

// Load business info for events email
let eventsEmail = "events@climbtheknot.com";
try {
  const biPath = path.join(process.cwd(), "src/content/business-info.json");
  const raw = fs.readFileSync(biPath, "utf-8");
  const parsed = JSON.parse(raw);
  if (parsed?.contact?.eventsEmail) eventsEmail = parsed.contact.eventsEmail;
} catch (e) {
  // Use default
}

function parseDate(value?: string): Date | null {
  if (!value) return null;
  const parsed = new Date(value);
  return Number.isNaN(parsed.getTime()) ? null : parsed;
}

function formatDate(value?: string): string {
  const parsed = parseDate(value);
  if (!parsed) return "Date TBD";
  return parsed.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

// Render a single date, or a "start – end" range when an end date is set.
function formatDateRange(start?: string, end?: string): string {
  if (!end) return formatDate(start);
  return `${formatDate(start)} – ${formatDate(end)}`;
}

const allEvents = (await getCollection("events")).sort((left, right) => {
  const leftDate = parseDate(left.data.date);
  const rightDate = parseDate(right.data.date);

  if (!leftDate && !rightDate) return 0;
  if (!leftDate) return 1;
  if (!rightDate) return -1;
  return leftDate.getTime() - rightDate.getTime();
});

const now = new Date();
now.setHours(0, 0, 0, 0);

const isRecurring = (event: (typeof allEvents)[number]) =>
  isRecurringSchedule(event.data.recurring);

// Recurring events render as Upending-style blocks at the bottom of the page,
// not as calendar cards, and show regardless of their start date.
const recurringEvents = allEvents.filter(isRecurring);

// One-time, upcoming events only — these become the calendar cards and the
// "Our Next Event" feature. Recurring events are excluded here.
const upcomingEvents = allEvents.filter((event) => {
  if (isRecurring(event)) return false;
  const eventDate = parseDate(event.data.date);
  return !eventDate || eventDate.getTime() >= now.getTime();
});

const featuredEvent =
  upcomingEvents.find((event) => event.data.isFeatured) ??
  upcomingEvents[0] ??
  null;

const toPublicUrl = (libraryPath?: string | null) =>
  libraryPath && libraryPath.startsWith("public/")
    ? `/${libraryPath.slice("public/".length)}`
    : undefined;

const eventImage = (event: (typeof allEvents)[number]) =>
  event.data.image ||
  toPublicUrl(event.data.imageLibraryPath) ||
  hillsPlaceholder;

// The flyer is the primary image everywhere on the events index (cards, next
// event, detail blocks). Falls back to the event image, then the placeholder.
// The event image itself is only used as the hero on the dedicated event page.
const cardImage = (event: (typeof allEvents)[number]) => {
  const flyer = event.data.eventPage?.value;
  return (
    flyer?.flyer || toPublicUrl(flyer?.flyerLibraryPath) || eventImage(event)
  );
};

const eventParagraphs = (description?: string) =>
  (description ?? "")
    .split(/\n+/)
    .map((line) => line.trim())
    .filter(Boolean);

const eventTypeItems = [
  {
    title: "BOULDERING ONLY",
    content:
      "Bouldering is climbing without ropes on shorter walls with thick crash pads below. Great for first-time climbers and larger group events.",
  },
  {
    title: "TOP ROPE + BOULDERING",
    content:
      "Top rope events include harnesses and rope climbing lanes in addition to bouldering zones. Belay support requirements depend on group size.",
  },
  {
    title: "STAFF BELAY",
    content:
      "Need belayers? The Knot can provide trained staff belayers for private and corporate events when scheduled in advance.",
  },
  {
    title: "YOGA OR FITNESS CLASS",
    content:
      "Add yoga or fitness sessions to your event package. Availability depends on instructor schedules and gym staffing.",
  },
  {
    title: "BELAY CLASS",
    content:
      "Belay classes can be added for groups that want certification as part of the event experience.",
  },
  {
    title: "KIDS POLICIES",
    content:
      "Youth participants must follow age and supervision requirements. Contact staff for current youth policy details before booking.",
  },
];
---

<BaseLayout title="Events">
  <section class="hero-section">
    <img
      src={hillsPlaceholder}
      alt=""
      class="hero-bg"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <h1 class="hero-title">EVENTS</h1>
  </section>

  <section class="next-event-section">
    <div class="next-event-grid">
      <div class="next-event-main">
        <h2 class="section-title">OUR NEXT EVENT</h2>
        {
          featuredEvent ? (
            <>
              <h3 class="event-title">{featuredEvent.data.title}</h3>
              <p class="event-meta">
                {formatDateRange(featuredEvent.data.date, featuredEvent.data.endDate)}{" "}
                {featuredEvent.data.time ? `| ${featuredEvent.data.time}` : ""}
              </p>
              <p class="event-description">
                {featuredEvent.data.description ?? "Details coming soon."}
              </p>

              <a
                href={redpointEventsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary next-event-button"
              >
                REGISTRATION & MORE INFO
              </a>
            </>
          ) : (
            <p class="event-description">No upcoming events</p>
          )
        }
      </div>

      {featuredEvent && (
        <img
          src={cardImage(featuredEvent)}
          alt={featuredEvent.data.title}
          class="next-event-image"
        />
      )}
    </div>
  </section>

  <section class="calendar-section">
    <div class="section-inner">
    <h2 class="section-title">EVENT CALENDAR</h2>
    <p class="section-subtext">
      We host events almost every month. Click any event to learn more.
    </p>

    <div class="calendar-grid">
      {
        upcomingEvents.length > 0 ? (
          upcomingEvents.map((event) => (
            <button
              type="button"
              class="calendar-card"
              data-event-target={event.id}
              aria-expanded="false"
              aria-controls={`event-detail-${event.id}`}
            >
              <img
                src={cardImage(event)}
                alt={event.data.title}
                class="calendar-card-image"
                loading="lazy"
                decoding="async"
              />
              <div class="calendar-card-body">
                <h3 class="calendar-card-title">{event.data.title}</h3>
                <p class="calendar-card-date">{formatDateRange(event.data.date, event.data.endDate)}</p>
              </div>
            </button>
          ))
        ) : (
          <p class="calendar-empty">No upcoming events yet.</p>
        )
      }
    </div>

    {upcomingEvents.length > 0 && (
      <div class="event-detail-panel">
        {upcomingEvents.map((event) => (
          <article id={`event-detail-${event.id}`} class="event-detail" hidden>
            <button
              type="button"
              class="event-detail-close"
              data-event-close
              aria-label="Close event details"
            >
              &times;
            </button>
            <div class="event-detail-inner">
              <img
                src={cardImage(event)}
                alt={event.data.title}
                class="event-detail-image"
                loading="lazy"
                decoding="async"
              />
              <div class="event-detail-body">
                <h3 class="event-detail-title">{event.data.title}</h3>
                <p class="event-detail-meta">
                  {formatDateRange(event.data.date, event.data.endDate)}{" "}
                  {event.data.time ? `| ${event.data.time}` : ""}
                </p>
                {eventParagraphs(event.data.description).map((paragraph) => (
                  <p class="event-detail-description">{paragraph}</p>
                ))}
                <div class="event-detail-actions">
                  {event.data.eventPage?.discriminant && (
                    <a href={`/events/${event.id}`} class="btn-secondary">
                      VIEW EVENT PAGE
                    </a>
                  )}
                  {event.data.registrationLink && (
                    <a
                      href={event.data.registrationLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-primary"
                    >
                      REGISTRATION & MORE INFO
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
    </div>
  </section>

  <section class="group-events-section">
    <div class="section-inner">
    <h2 class="section-title">GROUP EVENTS</h2>
    <p class="section-subtext">Host your next event with The Knot!</p>
    <h3 class="group-subtitle">EVENT TYPES & PRICING</h3>
    <Accordion items={eventTypeItems} client:visible />
    <p class="group-footnote">
      Group events must be scheduled at least three weeks in advance. Fill out
      our inquiry form or shoot us an email to learn more. Group event
      scheduling is subject to gym and staff availability.
    </p>
    <div class="group-buttons">
      <a
        href="https://form.asana.com/?k=event-request"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary"
      >
        EVENT REQUEST FORM
      </a>
      <a href={`mailto:${eventsEmail}`} class="btn-primary">CONTACT US</a>
    </div>
    </div>
  </section>

  {
    recurringEvents.map((event) => (
      <section class="upending-section">
        <div class="upending-grid">
          <div>
            <h2 class="section-title">{event.data.title}</h2>
            {eventParagraphs(event.data.description).map((paragraph) => (
              <p class="event-description">{paragraph}</p>
            ))}
            {recurringScheduleLines(event.data.recurring, " ").map((line) => (
              <p class="event-description">
                <strong>{line.toUpperCase()}</strong>
              </p>
            ))}
            {event.data.registrationLink && (
              <a
                href={event.data.registrationLink}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary"
              >
                REGISTER HERE
              </a>
            )}
          </div>
          <img
            src={cardImage(event)}
            alt={event.data.title}
            class="upending-image"
            loading="lazy"
            decoding="async"
          />
        </div>
      </section>
    ))
  }

  <section class="upending-section">
    <div class="upending-grid">
      <div>
        <h2 class="section-title">UPENDING PARKINSONS</h2>
        <p class="event-description">
          The Knot is partnering with Up ENDing Parkinsons to provide guided
          climbing sessions for people living with Parkinson&apos;s Disease.
          Anyone living with PD is welcome to climb, and family members are
          encouraged to join.
        </p>
        <p class="event-description">
          <strong>WEDNESDAYS 10AM - 11:30AM</strong>
        </p>
        <p class="event-description">
          Admission, instruction, and rental gear are provided free of charge.
          No experience is required.
        </p>
        <a
          href="https://upendingparkinsons.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          REGISTER HERE
        </a>
      </div>
      <img
        src={hillsPlaceholder}
        alt="Event placeholder hills background"
        class="upending-image"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>
</BaseLayout>

<script>
  const cards = document.querySelectorAll<HTMLButtonElement>("[data-event-target]");
  const panels = document.querySelectorAll<HTMLElement>(".event-detail");

  function closeAll() {
    panels.forEach((panel) => (panel.hidden = true));
    cards.forEach((card) => card.setAttribute("aria-expanded", "false"));
  }

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      const id = card.getAttribute("data-event-target");
      const panel = document.getElementById(`event-detail-${id}`);
      if (!panel) return;

      // Clicking the active card again collapses it.
      const wasOpen = !panel.hidden;
      closeAll();
      if (!wasOpen) {
        panel.hidden = false;
        card.setAttribute("aria-expanded", "true");
        panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".event-detail-close").forEach((button) => {
    button.addEventListener("click", () => closeAll());
  });
</script>

<style>
  .hero-section {
    position: relative;
    height: 50vh;
    min-height: 350px;
    overflow: hidden;
  }

  .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-title {
    position: absolute;
    right: 5%;
    bottom: 24px;
    margin: 0;
    color: #fff;
    font-family: var(--font-heading);
    font-size: clamp(36px, 6vw, 64px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }

  .next-event-section,
  .calendar-section,
  .group-events-section,
  .upending-section {
    padding: 48px 24px;
    background: #000;
  }

  .calendar-section {
    background: #fff;
  }

  /* Centers a section's content in the same 1200px column the grids use, so
     titles, subtext, and group-events content all share the page's alignment. */
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    margin: 0 0 12px;
    color: #fff;
    font-family: var(--font-heading);
    font-size: clamp(24px, 3.6vw, 44px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .calendar-section .section-title {
    color: #000;
  }

  .section-subtext {
    margin: 0 0 20px;
    color: #ddd;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
  }

  .calendar-section .section-subtext {
    color: #4d4d4d;
  }

  .next-event-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    gap: 24px;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
  }

  .event-title {
    margin: 0 0 8px;
    color: #fff;
    font-family: var(--font-heading);
    font-size: clamp(18px, 2.6vw, 32px);
    text-transform: uppercase;
  }

  .event-meta,
  .event-description {
    margin: 0 0 12px;
    color: #e8e8e8;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
  }

  .next-event-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 6px;
  }

  .next-event-button {
    margin-top: 16px;
    width: min(100%, 320px);
  }

  .calendar-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
  }

  .calendar-card {
    display: block;
    text-decoration: none;
    border: 1px solid #dadada;
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
    color: inherit;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  button.calendar-card {
    width: 100%;
    padding: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .calendar-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
  }

  .event-detail-panel {
    max-width: 1200px;
    margin: 24px auto 0;
  }

  .event-detail {
    position: relative;
    border: 1px solid #dadada;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }

  .event-detail-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .event-detail-image {
    width: 100%;
    height: 100%;
    min-height: 220px;
    object-fit: cover;
    display: block;
  }

  .event-detail-body {
    padding: 24px 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .event-detail-title {
    margin: 0;
    color: #000;
    font-family: var(--font-heading);
    font-size: clamp(20px, 4vw, 28px);
    text-transform: uppercase;
    line-height: 1.1;
  }

  .event-detail-meta {
    margin: 0;
    color: #666;
    font-family: var(--font-body);
    font-size: 14px;
  }

  .event-detail-description {
    margin: 0;
    color: #333;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
  }

  .event-detail-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .event-detail-close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    z-index: 1;
  }

  @media (max-width: 900px) {
    .event-detail-inner {
      grid-template-columns: 1fr;
    }
  }

  .calendar-card-image {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    display: block;
  }

  .calendar-card-body {
    padding: 12px;
  }

  .calendar-card-title {
    margin: 0 0 4px;
    color: #000;
    font-family: var(--font-heading);
    font-size: 14px;
    text-transform: uppercase;
  }

  .calendar-card-date {
    margin: 0;
    color: #666;
    font-family: var(--font-body);
    font-size: 12px;
  }

  .calendar-empty {
    margin: 0;
    color: #4d4d4d;
    font-family: var(--font-body);
  }

  .group-subtitle {
    margin: 0 0 14px;
    color: #84babf;
    font-family: var(--font-heading);
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .group-footnote {
    margin: 18px 0 20px;
    color: #cfcfcf;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
  }

  .group-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .upending-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }

  .upending-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
  }

  @media (max-width: 900px) {
    .next-event-grid,
    .upending-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
