# Keystatic (required for GitHub storage/auth in production)
NODE_ENV=production
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# RPHQ GraphQL API (powers the live class schedule on /classes)
RPHQ_ORG=theknot
RPHQ_API_TOKEN=
RPHQ_FACILITY=CTK
# Optional: run this report id directly and skip the name-discovery call.
# If unset or stale, the code self-heals by looking the id up by name.
RPHQ_REPORT_ID=

# Notes:
# - Set these in Cloudflare Pages → Settings → Environment variables (Production + Preview).
# - Do not commit real secrets to git; keep them in `.env` locally (ignored) and in Cloudflare as encrypted vars.
# - RPHQ_ORG is the ACCOUNT host (no facility code) in https://<RPHQ_ORG>.rphq.com/api/graphql
#   e.g. "theknot" → https://theknot.rphq.com/api/graphql  (NOT "theknot-ctk").
# - RPHQ_FACILITY is the facility code sent as the `X-Redpoint-Hq-Facility` header, e.g. "CTK".
#   (Redpoint is moving facility context off the subdomain and onto this header.)
# - RPHQ_API_TOKEN is sent as `Authorization: Bearer <token>`.
